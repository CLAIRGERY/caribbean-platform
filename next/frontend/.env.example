# =============================================================================
# SaKgaZe Next - environment configuration
# Copy to .env and set your values. NEVER commit .env with secrets.
# =============================================================================

# --- Backend API --------------------------------------------------------------
# Base URL of the API (legacy Render backend today, future NEW Render backend).
# Migration to the new backend only requires changing this variable, provided
# the API contract stays compatible.
VITE_API_BASE_URL=https://sakgaze-api.onrender.com/api/v1

# --- TEST FIXTURES (DEVELOPMENT ONLY) -----------------------------------------
# When true, local fixtures from scripts/fixtures/ are served and a DEV "TEST
# DATA" indicator appears. ALWAYS false in production — fixtures must never
# auto-load.
VITE_USE_TEST_FIXTURES=false
