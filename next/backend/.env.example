# =============================================================================
# SaKgaZé API v2 — environment template. Copy to .env, never commit .env.
# =============================================================================

# --- Database (required) ------------------------------------------------------
# Postgres + PostGIS connection string. Supabase: use the SESSION pooler (5432)
# for migrations, and the transaction pooler (6543) for the API if desired.
# Never commit a real value; never put it in a VITE_ variable.
DATABASE_URL=

# --- HTTP --------------------------------------------------------------------
# Comma-separated allowed origins (no wildcard in production).
CORS_ORIGINS=https://sakgaze.com,https://www.sakgaze.com,http://localhost:5173
# development | staging | production
API_ENV=production
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=json

# --- GeoJSON delivery ---------------------------------------------------------
# Client-side geometry simplification (degrees). 0.0005 ≈ 55 m at 15°N.
# Stored geometries are NEVER simplified.
MAP_SIMPLIFY_TOLERANCE=0.0005
GZIP_MIN_SIZE=1024

# --- Bounded queries ----------------------------------------------------------
MAX_LIMIT_SARGASSUM=2000
MAX_LIMIT_DRIFT=3000
MAX_LIMIT_ALERTS=1000
MAX_DAYS=90

# --- Database limits ----------------------------------------------------------
DB_STATEMENT_TIMEOUT_MS=8000
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# --- Schema -------------------------------------------------------------------
# Alembic owns the schema. Leave this at 0: boot-time DDL is forbidden.
SAKGAZE_AUTO_MIGRATE=0
