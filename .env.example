# =============================================================================
# SaKgaZé — Environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# =============================================================================

# --- Database (Supabase PostGIS) ---
# Paste the EXACT connection string from: Supabase → Connect → Transaction pooler.
# Render / Supabase already injects this; set it locally or in CI as a secret.
DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:[DB_PASSWORD]@<EXACT-POOLER-HOST>:6543/postgres

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://sakgaze.com,http://localhost:3000,http://127.0.0.1:3000

# --- Copernicus Data Space Ecosystem (Sentinel-2) ---
# Optional. Required ONLY for full band streaming + FAI computation.
# Without these, the sargassum collector returns empty (no synthetic fallback).
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=cdse-public
# CDSE S3 object storage (required to stream Sentinel-2 s3://eodata/... COGs).
# Generate these in the CDSE dashboard → My Account → S3 access.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=eodata.dataspace.copernicus.eu
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
S2_COLLECTION=sentinel-2-l2a
S2_MAX_CLOUD_COVER=20
FAI_THRESHOLD=0.008
SARGASSUM_LOOKBACK_DAYS=30

# --- Marine data sources (public, no key required) ---
NHC_STORMS_URL=https://www.nhc.noaa.gov/CurrentStorms.json
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# --- Ingestion HTTP robustness ---
INGESTION_REQUEST_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF_BASE=2.0
INGESTION_USER_AGENT=SaKgaZe-Ingestion/1.0 (+https://sakgaze.com)
